# ╔══════════════════════════════════════════════════════════╗
# ║          КОНФИГУРАЦИЯ ЭЦП ГОСТ Р 34.10-2012              ║
# ╚══════════════════════════════════════════════════════════╝

# ─── Параметры эллиптической кривой ───────────────────────────────────────────────
# Все значения задаются в HEX-формате!
# a, b - коэффициенты эллиптической кривой
# p - модуль эллиптической кривой, обязательно простое число
# q - порядок подгруппы эллиптической кривой, обязательно простое число
# x_P, y_P - образующая точка подгруппы порядка q
# d - закрытый ключ подписи, 0 < d < q
a=
b=
p=
q=
x_P=
y_P=
d=

# ─── Размер хеш-кода ─────────────────────────────────────────────────────────────
# Алгоритм ГОСТ Р 34.11-2012 (Streebog)
# Возможные значения: 256 или 512 бит
HASHSIZE=256


# ╔══════════════════════════════════════════════════════════╗
# ║                         ФАЙЛЫ                            ║
# ╚══════════════════════════════════════════════════════════╝

# ─── Пути к файлам по умолчанию ───────────────────────────────────────────────────
# Используются, если не переданы аргументы -f / --file через CLI.
DEFAULT_INPUT_FILE=initial_text.txt


# ╔══════════════════════════════════════════════════════════╗
# ║                      ЛОГИРОВАНИЕ                         ║
# ╚══════════════════════════════════════════════════════════╝

# ─── Уровень логирования ───────────────────────────────────────────────────────────
# Допустимые значения: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG


# ╔══════════════════════════════════════════════════════════╗
# ║               ПОВЕДЕНИЕ ПРИЛОЖЕНИЯ                       ║
# ╚══════════════════════════════════════════════════════════╝
# ─── Режим работы по умолчанию ─────────────────────────────────────────────────────
# Используется, если не передан аргумент -g / --generate 
# или -v / --verify через CLI.
# Допустимые значения: generate, verify
APP_MODE=verify

# ─── Перезапись выходного файла ────────────────────────────────────────────────────
# Если OVERWRITE=false — при совпадении имён файлов
# приложение завершится с ошибкой, не перезаписывая файл ЭЦП.
OVERWRITE=true